{
  "name": "gearbook",
  "version": "4.0.0",
  "description": "Gearbook — spec index of vintage cameras and lenses: the data asset and its contract, fuzzy search + batch-match engines, and the Explorer SPA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewalfish/gearbook-explorer.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/cameras.jsonl": "./data/gearbook/cameras.jsonl",
    "./data/lenses.jsonl": "./data/gearbook/lenses.jsonl",
    "./data/aliases.jsonl": "./data/gearbook/aliases.jsonl",
    "./package.json": "./package.json",
    "./data/redirects.jsonl": "./data/gearbook/redirects.jsonl",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "tsx scripts/validate-asset.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "data/gearbook",
    "README.md"
  ]
}
